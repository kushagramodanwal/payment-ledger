# Local PostgreSQL example. Create the database before starting the backend.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/wallet
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE_MINUTES=30
PORT=8000
INITIAL_BALANCE_INR=10000
PG_POOL_MAX=20
# Set true only when your PostgreSQL provider requires SSL.
PG_SSL=false
