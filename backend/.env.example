# MongoDB Atlas connection string (Atlas = replica set, needed for transactions)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wallet?retryWrites=true&w=majority
JWT_SECRET=put_a_long_random_string_here
JWT_EXPIRE_MINUTES=30
PORT=8000
# New user ko signup pe kitne rupees milenge (demo ke liye)
INITIAL_BALANCE_INR=10000
